# Copy to .env (never commit .env).
# Everything here is backend-only (Vercel project settings) except
# SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY, which the Flutter client may also use.

# YouCam API
YOUCAM_MODE=mock                # mock | live  (mock = zero API calls)
YOUCAM_API_KEY=
YOUCAM_API_BASE=https://yce-api-01.makeupar.com
MOCK_TRYON_SECONDS=4            # how long a simulated try-on takes in mock mode

# Allowed browser origins, comma-separated (unset = localhost only)
CORS_ORIGINS=

# Unit ledger (hard caps, in YouCam units)
LEDGER_CAP_PER_EVENT=40
LEDGER_CAP_PER_PARTICIPANT=10

# Supabase (Auth, Postgres, Storage)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=       # safe in the client; access is enforced by row-level security
SUPABASE_SECRET_KEY=            # backend only, bypasses row-level security
SUPABASE_BUCKET=event-media

# Optional: short plain-language explanations of harmony results (never used for scoring)
GEMINI_API_KEY=
