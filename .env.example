# Copy to .env (never commit .env). All keys below are backend-only:
# they live in the Vercel project settings, never in the Flutter client.

# YouCam API
YOUCAM_MODE=mock                # mock | live  (mock = zero API calls)
YOUCAM_API_KEY=
YOUCAM_API_BASE=                # take the base URL from the official YouCam API docs

# Unit ledger (hard caps, in YouCam units)
LEDGER_CAP_PER_EVENT=40
LEDGER_CAP_PER_PARTICIPANT=10

# Firebase Admin (Auth token verification + Firestore), base64-encoded service account JSON
FIREBASE_SERVICE_ACCOUNT_B64=

# Media storage (used only if Firebase Storage is unavailable on the free plan)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=event-media

# Optional: short plain-language explanations of harmony results (never used for scoring)
GEMINI_API_KEY=
