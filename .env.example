# Copy to .env (never commit .env).
# Everything here is backend-only (Vercel project settings) except
# SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY, which the client receives from /api/config.

# Try-on engine
YOUCAM_MODE=mock                # mock (simulated, zero API calls) | live (real YouCam API)
YOUCAM_API_KEY=
YOUCAM_API_BASE=https://yce-api-01.makeupar.com
MOCK_TRYON_SECONDS=4            # how long a simulated try-on takes

# Data
DATA_MODE=memory                # memory (no accounts needed, resets on restart) | supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=       # safe in the client; tables are closed by row-level security
SUPABASE_SECRET_KEY=            # backend only
SUPABASE_BUCKET=event-media
ALLOW_DEV_AUTH=false            # accept "dev.<uuid>" tokens next to Supabase Auth (never in production)

# Unit ledger (hard caps, in YouCam units)
LEDGER_CAP_PER_EVENT=40
LEDGER_CAP_PER_PARTICIPANT=10
LEDGER_ACCOUNT_RESERVE=0        # units to always keep on the account

# Allowed browser origins, comma-separated (unset = localhost only)
CORS_ORIGINS=

# Optional: short plain-language summaries of harmony results (never used for scoring)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
